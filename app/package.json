{
  "name": "mnemo",
  "version": "0.5.0",
  "private": true,
  "description": "Git client desktop visual, local",
  "main": "dist-electron/main.cjs",
  "type": "module",
  "scripts": {
    "native": "node scripts/build-native.mjs",
    "dev": "node scripts/dev.mjs",
    "dev:renderer": "vite",
    "build:renderer": "vite build",
    "build:electron": "node scripts/build-electron.mjs",
    "build": "bun run native && bun run build:renderer && bun run build:electron",
    "start": "electron .",
    "typecheck": "tsc --noEmit",
    "bench:startup": "node scripts/bench-startup.mjs",
    "native:release": "node scripts/build-native.mjs --release",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "dist": "bun run native:release && bun run build:renderer && bun run build:electron && electron-builder --publish never"
  },
  "dependencies": {
    "@codemirror/commands": "6",
    "@codemirror/lang-css": "6",
    "@codemirror/lang-html": "6",
    "@codemirror/lang-java": "6",
    "@codemirror/lang-javascript": "6",
    "@codemirror/lang-json": "6",
    "@codemirror/lang-markdown": "6",
    "@codemirror/lang-python": "6",
    "@codemirror/lang-rust": "6",
    "@codemirror/lang-sass": "6",
    "@codemirror/lang-sql": "6",
    "@codemirror/lang-xml": "6",
    "@codemirror/lang-yaml": "6",
    "@codemirror/language": "6",
    "@codemirror/state": "6",
    "@codemirror/view": "6",
    "@fontsource/ibm-plex-sans": "5",
    "@fontsource/jetbrains-mono": "5",
    "@lezer/common": "1",
    "@lezer/highlight": "1",
    "@tanstack/react-virtual": "^3.14.14",
    "electron-updater": "^6.8.9",
    "lucide-react": "^1.57.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@babel/core": "^8.0.7",
    "@rolldown/plugin-babel": "^0.2.4",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "babel-plugin-react-compiler": "^1.0.0",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  },
  "trustedDependencies": [
    "electron",
    "esbuild"
  ],
  "homepage": "https://github.com/luizfranzon/mnemo",
  "author": {
    "name": "Luiz Fernando Franzon",
    "email": "luizfranzon05@hotmail.com"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/luizfranzon/mnemo.git"
  },
  "build": {
    "appId": "com.mnemo.app",
    "productName": "Mnemo",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "dist-electron/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "native/mnemo.node",
        "to": "native/mnemo.node"
      }
    ],
    "publish": {
      "provider": "github",
      "owner": "luizfranzon",
      "repo": "mnemo"
    },
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Mnemo-Setup-${version}.${ext}"
    },
    "linux": {
      "target": [
        "deb",
        "rpm"
      ],
      "category": "Development",
      "maintainer": "Luiz Fernando Franzon <luizfranzon05@hotmail.com>"
    },
    "deb": {
      "depends": [
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libuuid1",
        "libsecret-1-0",
        "git"
      ]
    },
    "rpm": {
      "depends": [
        "gtk3",
        "libnotify",
        "nss",
        "libXScrnSaver",
        "(libXtst or libXtst6)",
        "xdg-utils",
        "at-spi2-core",
        "libuuid",
        "git"
      ]
    }
  }
}
